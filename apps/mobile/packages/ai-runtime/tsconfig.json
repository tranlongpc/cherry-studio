{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "paths": {
      "@cherrystudio/mobile-ai-core/core": ["../ai-core/src/core/index.ts"],
      "@cherrystudio/mobile-ai-core/core/*": ["../ai-core/src/core/*"],
      "@cherrystudio/mobile-provider-registry": ["../provider-registry/src/index.ts"],
      "@cherrystudio/mobile-provider-registry/*": ["../provider-registry/src/*"],
      "@cherrystudio/universal/*": ["../universal/src/*"],
      "@shared/*": ["../universal/src/*"]
    },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["node", "vitest/globals"]
  },
  "exclude": ["node_modules"],
  "include": ["src/**/*.ts", "scripts/**/*.ts", "vitest.config.ts"]
}
